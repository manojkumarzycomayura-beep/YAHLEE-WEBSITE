# ─── Yahlee Boutique Frontend — Environment Variables ───────────────────────
#
# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables in the dashboard.

# Backend API URL (production only)
# Set this to your Render backend URL after deploying the backend.
# Example: https://yahlee-boutique-api.onrender.com
#
# Leave empty in local development — the Vite proxy handles it automatically.
VITE_API_BASE_URL=
